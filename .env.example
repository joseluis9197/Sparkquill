# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Neon, Supabase or a local instance all work.
DATABASE_URL="postgresql://user:password@host/sparkquill?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stripe. Test keys during development.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# CDN origin for pre-generated audio (Cloudflare R2)
NEXT_PUBLIC_ASSET_URL=""
