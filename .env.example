# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Neon, Supabase or a local instance all work.
DATABASE_URL="postgresql://user:password@host/sparkquill?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stripe. Optional: leave blank and billing stays off, with the paid features
# open and the dashboard saying so. See docs/stripe-setup.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""

# Email, for password resets. Without it the reset flow tells parents to
# contact support rather than promising an email that will never arrive.
# In development the link is logged to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Sparkquill <no-reply@prosperollc.com>"

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# CDN origin for pre-generated audio (Cloudflare R2)
NEXT_PUBLIC_ASSET_URL=""
