# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Neon, Supabase or a local instance all work.
DATABASE_URL="postgresql://user:password@host/sparkquill?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stripe. Optional: leave blank and billing stays off, with the paid features
# open and the dashboard saying so. See docs/stripe-setup.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
# Optional. Names Sparkquill's own billing-portal configuration, so a parent
# does not land on the default one belonging to another product on the same
# Stripe account.
STRIPE_PORTAL_CONFIGURATION=""

# Email, for password resets. Without it the reset flow tells parents to
# contact support rather than promising an email that will never arrive.
# In development the link is logged to the server console instead.
#
# SMTP takes precedence over Resend. Production uses SMTP because the server
# already has a working account; either works.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Sparkquill <no-reply@prosperollc.com>"

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# CDN origin for pre-generated audio (Cloudflare R2)
NEXT_PUBLIC_ASSET_URL=""
